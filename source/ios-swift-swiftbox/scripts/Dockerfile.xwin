# AdaptiveCards Swiftbox bridge — matching Linux Swift compiler + WineHQ.
# The host-mounted Windows SDK must have the exact same Swift release as BASE.
ARG BASE=swift:6.3.1-jammy
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive \
    WINEDEBUG=-all \
    WINEDLLOVERRIDES="mscoree,mshtml=" \
    WINEPREFIX=/opt/wineprefix \
    XDG_RUNTIME_DIR=/tmp/xdg
RUN dpkg --add-architecture i386 && apt-get update && \
    apt-get install -y --no-install-recommends wget ca-certificates gnupg && \
    mkdir -pm755 /etc/apt/keyrings && \
    wget -qO /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key && \
    wget -qNP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/ubuntu/dists/jammy/winehq-jammy.sources && \
    apt-get update && apt-get install -y --install-recommends winehq-stable && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /tmp/xdg && \
    wineboot -i && wineserver -w
